flowchart TB
    ids["Input token IDs"] --> emb["Learned token embedding"]
    emb --> en["Parameter-free RMSNorm"]
    en --> stack["L Transformer blocks: expanded below"]
    stack --> fn["Final parameter-free RMSNorm"]
    fn --> head["Bias-free vocabulary projection<br/>Weights NOT tied to input embedding"]
    head --> cap["Logit soft cap: 15 tanh(z / 15)"]
    cap --> logits["Next-token logits"]
    logits --> loss["Training: cross-entropy with next-token targets"]

    subgraph block["One Transformer block - repeated L times"]
        x["Residual input X"] --> n1["Parameter-free RMSNorm"]
        n1 --> q["Q projection"]
        n1 --> k["K projection"]
        n1 --> v["V projection"]
        q --> qr["RoPE"] --> qn["Per-head RMSNorm"]
        k --> kr["RoPE"] --> kn["Per-head RMSNorm"]
        qn --> att["Full causal scaled dot-product attention"]
        kn --> att
        v --> att
        att --> proj["Concatenate heads + output projection"]
        proj --> a1(("+"))
        x --> a1
        a1 --> n2["Parameter-free RMSNorm"]
        n2 --> up["Linear: d to 4d"]
        up --> relu["Squared ReLU"]
        relu --> down["Linear: 4d to d"]
        down --> a2(("+"))
        a1 --> a2
        a2 --> y["Residual output Y"]
    end
    stack -. "detail, not an additional computation" .-> x

    classDef normal fill:#eff6ff,stroke:#1e40af,color:#172554;
    classDef residual fill:#dbeafe,stroke:#1e40af,color:#172554;
    class ids,emb,en,fn,head,cap,logits,loss,n1,q,k,v,qr,kr,qn,kn,att,proj,n2,up,relu,down normal;
    class stack,x,a1,a2,y residual;
