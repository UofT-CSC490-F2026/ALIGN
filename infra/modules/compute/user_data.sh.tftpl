#!/bin/bash
set -Eeuo pipefail
umask 027

if (( EUID != 0 )); then
  printf 'ALIGN bootstrap must run as root.\n' >&2
  exit 1
fi

exec > >(tee -a /var/log/align-bootstrap.log) 2>&1
trap 'status=$?; printf "ALIGN bootstrap failed at line %s (exit %s).\n" "$LINENO" "$status" >&2; exit "$status"' ERR

. /etc/os-release
if [[ "$${ID:-}" != "amzn" || "$${VERSION_ID:-}" != "2023" || "$(uname -m)" != "x86_64" ]]; then
  printf 'ALIGN bootstrap requires Amazon Linux 2023 on x86_64.\n' >&2
  exit 1
fi

# AL2023 does not install cron by default. No Git checkout is required.
dnf install -y docker awscli-2 python3 cronie tzdata
systemctl enable --now docker
systemctl enable --now amazon-ssm-agent
systemctl is-active --quiet docker
systemctl is-active --quiet amazon-ssm-agent
docker info --format '{{.ServerVersion}}'

/usr/bin/python3 - <<'PY'
import base64
import gzip
import json
import os
from pathlib import Path
import subprocess

bundle = json.loads(gzip.decompress(base64.b64decode('${runtime_bundle}')))
config = bundle['config']

# An already-running cron daemon must not see the smoke job during startup.
# Cron ignores the dot-prefixed staging file; replacement publishes a whole file.
cron_path = Path('/etc/cron.d/align-smoke')
cron_staging_path = Path('/etc/cron.d/.align-smoke.tmp')

def write_cron(content):
    cron_staging_path.write_text(content)
    os.chmod('/etc/cron.d/.align-smoke.tmp', 0o644)
    cron_staging_path.replace(cron_path)

write_cron('# ALIGN smoke tests are disabled.\n')
Path('/etc/align').mkdir(mode=0o700, exist_ok=True)
Path('/opt/align').mkdir(mode=0o755, exist_ok=True)
assets = [
    ('/etc/align/config.json', json.dumps(config), 0o600),
    ('/opt/align/run_container.py', bundle['runner'], 0o755),
]
for filename, content, mode in assets:
    Path(filename).write_text(content)
    os.chmod(filename, mode)

if config['service_enabled']:
    subprocess.run(['/usr/bin/python3', '/opt/align/run_container.py', 'service'], check=True)
if config['smoke_enabled']:
    if not (Path('/usr/share/zoneinfo') / bundle['timezone']).is_file():
        raise RuntimeError('Smoke-test timezone is not installed')
    write_cron(bundle['cron'])
    subprocess.run(['systemctl', 'enable', '--now', 'crond'], check=True)
PY

printf 'ALIGN bootstrap completed; workloads run only when explicitly enabled.\n'
